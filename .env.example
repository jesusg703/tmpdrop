# Optional settings. Copy to .env and edit; every value below has a working
# default, so a .env file is not required for `docker compose up -d`.

# Which interface the port is published on. The default is every interface,
# because tmpdrop is meant to be reachable from the machines you share with.
# TMPDROP HAS NO LOGIN: anyone who can reach that port lists and deletes
# everything. Set this to 127.0.0.1 to keep it on the local machine only.
#TMPDROP_BIND=0.0.0.0

# --- Conversion -------------------------------------------------------------
# Conversion is on by default: compose.yaml runs ConvertX and points tmpdrop at
# it. CONVERTX_URL is the switch — set it empty to turn the integration off and
# hide the Convert button.
#CONVERTX_URL=http://convertx:3000

# Credentials tmpdrop uses for ConvertX. The account is created automatically on
# first use, so you only pick the values. They are NOT optional while
# CONVERTX_URL is set: an empty email or password makes tmpdrop exit with
# "convertx.url requires convertx.email and convertx.password".
#CONVERTX_EMAIL=tmpdrop@example.com
#CONVERTX_PASSWORD=tmpdrop-demo

# Changing the password later does not update the account already stored in the
# convertx volume, and conversions then fail with "authentication failed
# (status 403)". Either keep the original values or start over with
# `docker compose down -v` (which also deletes the uploaded files).

# Signing secret for ConvertX sessions. Any fixed string works; changing it
# just logs the account out.
#JWT_SECRET=change-me-before-deploying

# Timezone used for container logs.
#TZ=Europe/Madrid

# --- tmpdrop ----------------------------------------------------------------
# Where the footer "Source code" link points. If you modify tmpdrop and run it
# as a network service, AGPL section 13 requires this to be YOUR source.
#TMPDROP_SOURCE_URL=https://github.com/you/your-fork

# Any config.json key also accepts an environment variable with the same
# name; it takes precedence over the file.
#TMPDROP_DEFAULT_TTL=24h
#TMPDROP_MAX_FILE_SIZE=100MB
#TMPDROP_QUOTA_DEFAULT=250MB
#TMPDROP_MAX_STORAGE=1GB
